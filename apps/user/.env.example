# API base URL. Empty uses the page origin; Vite proxies to localhost:8080 in development.
VITE_API_BASE_URL=
# Optional reverse-proxy prefix (e.g. /api). Empty calls /v1 and /v2 directly.
# Production proxies must strip this prefix before forwarding to the backend.
VITE_API_PREFIX=

# Local tutorial documents are disabled by default because no reviewed snapshot
# is bundled. After adding SUMMARY.md and its content under public/assets/tutorial,
# set this to true. A custom same-origin path such as /assets/tutorial is also
# accepted; absolute URLs and traversal paths are rejected.
VITE_TUTORIAL_DOCUMENT=false

# Show landing page on home route (true/false, default: true)
# When set to false, users will be redirected to login page directly
VITE_SHOW_LANDING_PAGE=true

# Default login credentials (for development only)
VITE_USER_EMAIL=
VITE_USER_PASSWORD=
